# ============ 大模型（不配置则走内置规则引擎）============
LLM_MODE=auto
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=45

# ============ 对接真实环境（不配置则全部走 mock，Demo 不受影响）============

# 计算资源：mock / openstack
COMPUTE_DRIVER=mock
OS_AUTH_URL=
OS_USERNAME=
OS_PASSWORD=
OS_PROJECT_NAME=admin
OS_USER_DOMAIN=Default
OS_PROJECT_DOMAIN=Default
OS_REGION=RegionOne
OS_NETWORK_ID=
OS_AVAILABILITY_ZONE=
OS_TIMEOUT=30
# 拓扑里的镜像名 → OpenStack 镜像 UUID
OS_IMAGE_MAP={"ubuntu-2204-server": "", "kali-2024-attacker": ""}
COMPUTE_TIMEOUT=900

# 监控指标：mock / prometheus
METRICS_DRIVER=mock
PROM_URL=http://127.0.0.1:9090
PROM_TIMEOUT=10
PROM_NIC=eth0
PROM_NIC_BPS=1000000000

# 资源同步：mock / cmdb
RESOURCE_DRIVER=mock
CMDB_URL=
CMDB_TOKEN=
CMDB_IMAGE_PATH=/api/v1/images
CMDB_COMPUTE_PATH=/api/v1/nodes
CMDB_NETWORK_PATH=/api/v1/networks
CMDB_STORAGE_PATH=/api/v1/storages
# 定时同步间隔（秒），0 表示只在手动触发 /api/resources/sync 时同步
RESOURCE_SYNC_INTERVAL=0

# 告警接入：mock / alertmanager（也支持 webhook 推送）
ALERT_DRIVER=mock
ALERT_URL=http://127.0.0.1:9093

# 调度阈值（用于 /api/scheduler/evaluate 阈值巡检）
THRESHOLD_CPU=85
THRESHOLD_MEMORY=85
THRESHOLD_NETWORK=90

# ============ 数据库 ============
# DATABASE_URL=sqlite:///./data/craas.db
# DATA_DIR=./data
